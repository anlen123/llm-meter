# LLM Meter 凭证配置示例
# 复制为 config/meter.env 后修改；不要把真实密钥提交到仓库。
# 加载方式：python3 llm_meter.py --env-file config/meter.env web
# 规则：NAME=value；允许引号和注释；不展开 $变量，不执行 shell 命令。
# 同名变量以本文件为准；不使用的服务请留空。修改后重启网页 / 代理。

# ── OpenRouter ──────────────────────────────────────────────
# 普通推理 key：查询当前 key 的费用摘要，也可用于 OpenRouter 代理推理。
# 将下面占位符换成真实 key；不用 OpenRouter 时改为 OPENROUTER_API_KEY=
OPENROUTER_API_KEY='REPLACE_WITH_OPENROUTER_API_KEY'

# 管理 key：查询历史 token / 模型 / 金额；不能用于推理。
# 可选。取得管理 key 后在等号后填写，例如 'REPLACE_WITH_MANAGEMENT_KEY'。
# 留空时只查询普通 key 摘要，没有远端模型历史。
OPENROUTER_MANAGEMENT_KEY=

# ── AIHub / 其他中转站 ───────────────────────────────────────
# AIHub 普通推理 key。实际 base URL 在 proxy --upstream 参数里配置。
# 不用 AIHub 时改为 AIHUB_API_KEY=
AIHUB_API_KEY='REPLACE_WITH_AIHUB_API_KEY'

# 第二个中转站的独立 key；proxy 使用 --key-env RELAY_B_API_KEY 读取。
# 不使用时保持为空。
RELAY_B_API_KEY=

# ── 本地代理鉴权 ─────────────────────────────────────────────
# 自己设置的独立 token，不是服务商 key；请换成长随机值。
# 代理启动时加 --local-key-env LOCAL_METER_KEY 才会启用。
# 启用后 pi / omp / Codex 客户端的 API key 填这个值。
LOCAL_METER_KEY='REPLACE_WITH_A_LONG_RANDOM_LOCAL_TOKEN'

# 注意：这里仅配置凭证，不设置模型、base URL、数据库或日志路径。
# 网页默认自动读取本机 pi / omp / Codex 日志，不需要这些凭证。
# 完整启动命令与 provider 映射示例见 config/README.md。
